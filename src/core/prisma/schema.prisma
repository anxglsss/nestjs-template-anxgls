generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  firstName String
  lastName  String
  nickName  String  @unique
  bio       String?

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, nickName, firstName, lastName])
  @@map("users")
}

model Post {
  id       String  @id @default(uuid())
  title    String
  content  String
  authorId String
  isPublic Boolean @default(true)

  User User? @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, isPublic, createdAt])
  @@map("posts")
}
